DB_URL=jdbc:postgresql://localhost:5433/busbooking
DB_USERNAME=busbooking_user
DB_PASSWORD=YOUR_PASSWORD

# Base64 of at least 32 random bytes, e.g. openssl rand -base64 32 (not the OTP key).
JWT_SECRET=REPLACE_WITH_BASE64_RANDOM_JWT_KEY
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=busbooking

# Separate database for automated tests. Never point this at development data.
TEST_DB_URL=jdbc:postgresql://localhost:55433/busbooking_test
TEST_DB_USERNAME=busbooking_test
TEST_DB_PASSWORD=YOUR_TEST_PASSWORD

# Generate a separate random Base64 key (at least 32 decoded bytes): openssl rand -base64 32
EMAIL_OTP_SECRET=REPLACE_WITH_BASE64_RANDOM_KEY
SMTP_FROM=noreply@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# false only for local Mailpit; enable both for a real SMTP provider.
SMTP_AUTH=false
SMTP_STARTTLS=false

# Dev/test enable docs by default; other profiles default to disabled.
API_DOCS_ENABLED=true
# Empty unless a browser frontend is used; comma-separated exact origins, no wildcard.
CORS_ALLOWED_ORIGINS=
AUTH_RATE_WINDOW_SECONDS=60
AUTH_RATE_MAX_KEYS=10000
AUTH_RATE_REGISTER_LIMIT=5
AUTH_RATE_LOGIN_LIMIT=10
AUTH_RATE_VERIFY_LIMIT=20
AUTH_RATE_RESEND_LIMIT=5

# First SUPER_ADMIN only, dev/test opt-in. OTP email verification is still mandatory.
BOOTSTRAP_SUPER_ADMIN_ENABLED=false
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_FULL_NAME=
BOOTSTRAP_SUPER_ADMIN_PHONE=
